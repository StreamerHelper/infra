#!/bin/bash

#=============================================================#
#  StreamerHelper Container Control Script                    #
#  Usage: ./bin/control <command> [subcommand] [options]      #
#=============================================================#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INFRA_DIR="$(dirname "$SCRIPT_DIR")"
CONFIG_DIR="${STREAMER_HELPER_CONFIG_DIR:-$HOME/.streamer-helper}"
CONFIG_FILE="$CONFIG_DIR/settings.json"
ENV_FILE="$CONFIG_DIR/.docker-env"
RELEASE_VERSION_FILE="$CONFIG_DIR/release-version"
SERVICE_VERSIONS_FILE="$CONFIG_DIR/service-versions.json"
SERVICE_VERSIONS_PREVIOUS_FILE="$CONFIG_DIR/service-versions.previous.json"

CONTROL_PINNED_RELEASE_VERSION=""
if [ -r "$RELEASE_VERSION_FILE" ]; then
    IFS= read -r CONTROL_PINNED_RELEASE_VERSION < "$RELEASE_VERSION_FILE" || true
fi

# Non-interactive SSH and launchd sessions often miss /usr/local/bin and
# OrbStack's user-local shims.
export PATH="$HOME/.orbstack/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

DEFAULT_HTTP_PORT=7080
DEFAULT_HTTPS_PORT=7443
DEFAULT_MINIO_API_PORT=7090
DEFAULT_MINIO_CONSOLE_PORT=7091
DEFAULT_INTERNAL_MINIO_ENDPOINT="http://minio:${DEFAULT_MINIO_API_PORT}"
DEFAULT_PUBLIC_MINIO_ENDPOINT="http://localhost:${DEFAULT_MINIO_API_PORT}"

# Compose files
COMPOSE_INFRA="$INFRA_DIR/docker-compose.infra.yml"
COMPOSE_APP="$INFRA_DIR/docker-compose.app.yml"
COMPOSE_DEV="$INFRA_DIR/docker-compose.dev.yml"

# Image settings
DOCKER_REGISTRY="${DOCKER_REGISTRY:-ghcr.io}"
DOCKER_ORG="${DOCKER_ORG:-streamerhelper}"
IMAGE_PREFIX="${IMAGE_PREFIX:-streamerhelper}"
CONTROL_BACKEND_VERSION="${BACKEND_VERSION:-}"
CONTROL_FRONTEND_VERSION="${FRONTEND_VERSION:-}"
CONTROL_BROWSER_VERSION="${BROWSER_VERSION:-}"
CONTROL_DOUYIN_RESOLVER_VERSION="${DOUYIN_RESOLVER_VERSION:-}"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step() { echo -e "${BLUE}[STEP]${NC} $1"; }

get_default_runtime() {
    local system
    local machine
    system="$(uname -s 2>/dev/null || printf '')"
    machine="$(uname -m 2>/dev/null || printf '')"

    if [ "$system" = "Darwin" ] && [ "$machine" = "arm64" ]; then
        printf 'orbstack'
    else
        printf 'docker'
    fi
}

get_deployment_runtime() {
    local runtime="${STREAMER_HELPER_RUNTIME:-}"
    local default_runtime
    default_runtime="$(get_default_runtime)"

    if [ -z "$runtime" ] && [ -f "$CONFIG_FILE" ] && command -v jq &> /dev/null; then
        runtime="$(jq -r '.deployment.runtime // empty' "$CONFIG_FILE" 2>/dev/null || printf '')"
    fi

    case "${runtime:-$default_runtime}" in
        docker|orbstack)
            printf '%s' "${runtime:-$default_runtime}"
            ;;
        *)
            echo -e "${YELLOW}[WARN]${NC} Unknown deployment runtime '${runtime}', falling back to ${default_runtime}" >&2
            printf '%s' "$default_runtime"
            ;;
    esac
}

prepare_container_runtime() {
    local runtime
    runtime="$(get_deployment_runtime)"

    case "$runtime" in
        orbstack)
            if ! command -v orb &> /dev/null; then
                log_error "OrbStack runtime selected, but 'orb' is not installed or not in PATH."
                log_error "Install OrbStack first: https://orbstack.dev/"
                exit 1
            fi

            log_step "Using OrbStack runtime..."
            if ! orb start > /dev/null 2>&1; then
                log_error "Failed to start OrbStack. Try opening OrbStack once from macOS or run 'orb start' manually."
                exit 1
            fi

            if ! docker context inspect orbstack > /dev/null 2>&1; then
                log_error "OrbStack Docker context not found. Run 'orb start' and try again."
                exit 1
            fi

            export DOCKER_CONTEXT=orbstack
            ;;
        docker)
            ;;
    esac
}

is_valid_release_version() {
    local version="${1:-}"
    [ -n "$version" ] \
        && [ "$version" != "latest" ] \
        && [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]]
}

resolve_pinned_release_version() {
    if is_valid_release_version "$CONTROL_PINNED_RELEASE_VERSION"; then
        printf '%s' "$CONTROL_PINNED_RELEASE_VERSION"
        return 0
    fi
    return 1
}

resolve_default_application_version() {
    resolve_pinned_release_version
}

# Per-service version pins live in service-versions.json. They take precedence
# over the legacy single release-version pin so a backend-only release never
# drags the frontend/browser/resolver back to an older tag.
resolve_service_version() {
    local service="${1:-}"
    [ -n "$service" ] || return 1
    [ -r "$SERVICE_VERSIONS_FILE" ] || return 1
    command -v jq >/dev/null 2>&1 || return 1

    local version
    version="$(jq -r --arg service "$service" '.[$service] // empty' "$SERVICE_VERSIONS_FILE" 2>/dev/null)" || return 1
    is_valid_release_version "$version" || return 1
    printf '%s' "$version"
}

# Atomically write one service version (or all four with "all").
write_service_versions() {
    local service="${1:-}"
    local version="${2:-}"
    local services=(backend frontend browser douyin-resolver)

    is_valid_release_version "$version" || return 1
    if [ "$service" != "all" ]; then
        local known=0
        local candidate
        for candidate in "${services[@]}"; do
            if [ "$candidate" = "$service" ]; then known=1; fi
        done
        if [ "$known" -ne 1 ]; then
            log_error "Unknown application service: $service"
            return 1
        fi
    fi

    mkdir -p "$CONFIG_DIR" || return 1
    local temporary_file
    temporary_file="$(mktemp "$CONFIG_DIR/.service-versions.XXXXXX")" || return 1

    local write_ok=1
    if [ "$service" = "all" ]; then
        jq -n --arg version "$version" \
            '{backend: $version, frontend: $version, browser: $version, "douyin-resolver": $version}' \
            > "$temporary_file" || write_ok=0
    elif [ -s "$SERVICE_VERSIONS_FILE" ]; then
        jq --arg service "$service" --arg version "$version" \
            '.[$service] = $version' "$SERVICE_VERSIONS_FILE" \
            > "$temporary_file" || write_ok=0
    else
        jq -n --arg service "$service" --arg version "$version" \
            '{($service): $version}' > "$temporary_file" || write_ok=0
    fi

    if [ "$write_ok" -ne 1 ] || ! chmod 600 "$temporary_file"; then
        rm -f "$temporary_file"
        log_error "Failed to write service version manifest"
        return 1
    fi

    if [ -f "$SERVICE_VERSIONS_FILE" ]; then
        cp -p "$SERVICE_VERSIONS_FILE" "$SERVICE_VERSIONS_PREVIOUS_FILE" 2>/dev/null || true
    fi

    if ! mv -f "$temporary_file" "$SERVICE_VERSIONS_FILE"; then
        rm -f "$temporary_file"
        log_error "Failed to persist service version manifest"
        return 1
    fi
}

service_container_name() {
    case "${1:-}" in
        backend) printf 'streamer-backend' ;;
        frontend) printf 'streamer-frontend' ;;
        browser) printf 'streamer-browser' ;;
        douyin-resolver) printf 'streamer-douyin-resolver' ;;
        *) return 1 ;;
    esac
}

validate_existing_release_pin() {
    local persisted_version=""

    if [ ! -e "$RELEASE_VERSION_FILE" ]; then
        CONTROL_PINNED_RELEASE_VERSION=""
        return 0
    fi

    if [ ! -r "$RELEASE_VERSION_FILE" ]; then
        log_error "Application release pin is not readable: $RELEASE_VERSION_FILE"
        return 1
    fi

    if ! persisted_version="$(<"$RELEASE_VERSION_FILE")"; then
        log_error "Application release pin could not be read: $RELEASE_VERSION_FILE"
        return 1
    fi

    if [[ "$persisted_version" == *$'\n'* ]] \
        || ! is_valid_release_version "$persisted_version"; then
        log_error "Application release pin is invalid: $RELEASE_VERSION_FILE"
        log_error "Fix or remove the corrupt pin before continuing."
        return 1
    fi

    CONTROL_PINNED_RELEASE_VERSION="$persisted_version"
}

require_pinned_release_version() {
    validate_existing_release_pin || return 1

    if resolve_pinned_release_version >/dev/null; then
        return 0
    fi

    if [ -r "$SERVICE_VERSIONS_FILE" ] && command -v jq >/dev/null 2>&1; then
        if [ -n "$(jq -r 'to_entries[] | select(.value != null and .value != "") | .value' "$SERVICE_VERSIONS_FILE" 2>/dev/null | head -n 1)" ]; then
            return 0
        fi
    fi

    log_error "No application release is pinned."
    log_error "Run './bin/control infra up', then './bin/control update app <version>'."
    return 1
}

resolve_backend_version() {
    if [ -n "${CONTROL_BACKEND_VERSION:-}" ]; then
        printf '%s' "$CONTROL_BACKEND_VERSION"
    elif resolve_service_version backend; then
        :
    else
        resolve_default_application_version
    fi
}

resolve_frontend_version() {
    if [ -n "${CONTROL_FRONTEND_VERSION:-}" ]; then
        printf '%s' "$CONTROL_FRONTEND_VERSION"
    elif resolve_service_version frontend; then
        :
    else
        resolve_default_application_version
    fi
}

resolve_browser_version() {
    if [ -n "${CONTROL_BROWSER_VERSION:-}" ]; then
        printf '%s' "$CONTROL_BROWSER_VERSION"
    elif resolve_service_version browser; then
        :
    else
        resolve_default_application_version
    fi
}

resolve_douyin_resolver_version() {
    if [ -n "${CONTROL_DOUYIN_RESOLVER_VERSION:-}" ]; then
        printf '%s' "$CONTROL_DOUYIN_RESOLVER_VERSION"
    elif resolve_service_version douyin-resolver; then
        :
    else
        resolve_default_application_version
    fi
}

resolve_backend_image() {
    local version
    version="$(resolve_backend_version)" || return 1
    printf '%s/%s/%s-backend:%s' \
        "$DOCKER_REGISTRY" \
        "$DOCKER_ORG" \
        "$IMAGE_PREFIX" \
        "$version"
}

resolve_frontend_image() {
    local version
    version="$(resolve_frontend_version)" || return 1
    printf '%s/%s/%s-frontend:%s' \
        "$DOCKER_REGISTRY" \
        "$DOCKER_ORG" \
        "$IMAGE_PREFIX" \
        "$version"
}

resolve_browser_image() {
    local version
    version="$(resolve_browser_version)" || return 1
    printf '%s/%s/%s-browser:%s' \
        "$DOCKER_REGISTRY" \
        "$DOCKER_ORG" \
        "$IMAGE_PREFIX" \
        "$version"
}

resolve_douyin_resolver_image() {
    local version
    version="$(resolve_douyin_resolver_version)" || return 1
    printf '%s/%s/%s-douyin-resolver:%s' \
        "$DOCKER_REGISTRY" \
        "$DOCKER_ORG" \
        "$IMAGE_PREFIX" \
        "$version"
}

compose_app() {
    local backend_version
    local frontend_version
    local browser_version
    local douyin_resolver_version
    backend_version="$(resolve_backend_version)" || return 1
    frontend_version="$(resolve_frontend_version)" || return 1
    browser_version="$(resolve_browser_version)" || return 1
    douyin_resolver_version="$(resolve_douyin_resolver_version)" || return 1

    BACKEND_VERSION="$backend_version" \
    FRONTEND_VERSION="$frontend_version" \
    BROWSER_VERSION="$browser_version" \
    DOUYIN_RESOLVER_VERSION="$douyin_resolver_version" \
    docker compose -f "$COMPOSE_APP" --env-file "$ENV_FILE" "$@"
}

compose_app_dev() {
    BACKEND_VERSION=local \
    FRONTEND_VERSION=local \
    BROWSER_VERSION=local \
    DOUYIN_RESOLVER_VERSION=local \
    docker compose -f "$COMPOSE_APP" -f "$COMPOSE_DEV" --env-file "$ENV_FILE" "$@"
}

compose_app_down() {
    # Compose interpolates image references even for `down`. These placeholder
    # tags make stop-only operations independent of a release pin without
    # weakening the required-version checks for every other direct Compose use.
    BACKEND_VERSION=unused-for-down \
    FRONTEND_VERSION=unused-for-down \
    BROWSER_VERSION=unused-for-down \
    DOUYIN_RESOLVER_VERSION=unused-for-down \
    docker compose -f "$COMPOSE_APP" --env-file "$ENV_FILE" down "$@"
}

compose_all() {
    local backend_version
    local frontend_version
    local browser_version
    local douyin_resolver_version
    backend_version="$(resolve_backend_version)" || return 1
    frontend_version="$(resolve_frontend_version)" || return 1
    browser_version="$(resolve_browser_version)" || return 1
    douyin_resolver_version="$(resolve_douyin_resolver_version)" || return 1

    BACKEND_VERSION="$backend_version" \
    FRONTEND_VERSION="$frontend_version" \
    BROWSER_VERSION="$browser_version" \
    DOUYIN_RESOLVER_VERSION="$douyin_resolver_version" \
    docker compose -f "$COMPOSE_INFRA" -f "$COMPOSE_APP" --env-file "$ENV_FILE" "$@"
}

is_local_host() {
    case "${1:-}" in
        ""|"localhost"|"127.0.0.1"|"0.0.0.0"|"::1")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

split_url() {
    local url="${1:-}"
    URL_SCHEME="http"
    URL_HOST=""
    URL_PORT=""
    URL_PATH=""

    local rest="$url"
    if [[ "$rest" == *"://"* ]]; then
        URL_SCHEME="${rest%%://*}"
        rest="${rest#*://}"
    fi

    local host_port="${rest%%/*}"
    if [[ "$rest" == */* ]]; then
        URL_PATH="/${rest#*/}"
    fi

    if [[ "$host_port" == *":"* ]]; then
        URL_HOST="${host_port%%:*}"
        URL_PORT="${host_port##*:}"
    else
        URL_HOST="$host_port"
    fi
}

build_url() {
    local scheme="${1:-http}"
    local host="$2"
    local port="$3"
    local path="$4"

    printf '%s://%s' "$scheme" "$host"
    if [ -n "$port" ]; then
        printf ':%s' "$port"
    fi
    if [ -n "$path" ]; then
        printf '%s' "$path"
    fi
}

normalize_service_connection() {
    local host="$1"
    local port="$2"
    local service_name="$3"
    local default_port="$4"

    if is_local_host "$host"; then
        host="$service_name"
    fi

    if [ -z "$port" ]; then
        port="$default_port"
    fi

    if [ "$host" = "$service_name" ] || [ "$host" = "streamer-$service_name" ]; then
        port="$default_port"
    fi

    printf '%s %s' "$host" "$port"
}

normalize_internal_s3_endpoint() {
    local endpoint="$1"
    local minio_api_port="${2:-$DEFAULT_MINIO_API_PORT}"
    split_url "$endpoint"

    local scheme="${URL_SCHEME:-http}"
    local host="$URL_HOST"
    local port="$URL_PORT"
    local path="$URL_PATH"
    local use_minio_port=false

    if is_local_host "$host" || [ -z "$host" ] || [ "$host" = "minio" ] || [ "$host" = "streamer-minio" ]; then
        host="minio"
        use_minio_port=true
    fi

    if [ "$host" = "minio" ] || [ "$host" = "streamer-minio" ]; then
        host="minio"
        use_minio_port=true
    fi

    if [ "$use_minio_port" = true ]; then
        port="$minio_api_port"
    fi

    build_url "$scheme" "$host" "$port" "$path"
}

normalize_public_s3_endpoint() {
    local endpoint="$1"
    local minio_api_port="$2"
    split_url "$endpoint"

    local scheme="${URL_SCHEME:-http}"
    local host="$URL_HOST"
    local port="$URL_PORT"
    local path="$URL_PATH"

    if [ -z "$host" ] || [ "$host" = "minio" ] || [ "$host" = "streamer-minio" ]; then
        host="localhost"
    fi

    if [ -z "$port" ]; then
        port="$minio_api_port"
    fi

    if { [ "$host" = "localhost" ] || [ "$host" = "127.0.0.1" ] || [ "$host" = "0.0.0.0" ]; } \
        && { [ "$port" = "9000" ] || [ "$port" = "$DEFAULT_MINIO_API_PORT" ]; } \
        && [ "$port" != "$minio_api_port" ]; then
        port="$minio_api_port"
    fi

    build_url "$scheme" "$host" "$port" "$path"
}

#=============================================================#
#  Utility Functions                                          #
#=============================================================#

check_dependencies() {
    if ! command -v jq &> /dev/null; then
        log_error "jq is required. Install it: apt install jq / brew install jq"
        exit 1
    fi

    prepare_container_runtime

    if ! command -v docker &> /dev/null; then
        log_error "Docker CLI is not installed. Please install Docker, Docker Desktop, or OrbStack first."
        exit 1
    fi

    if ! docker info &> /dev/null; then
        log_error "Docker engine is not available for runtime '$(get_deployment_runtime)'."
        exit 1
    fi

    if ! docker compose version &> /dev/null; then
        log_error "Docker Compose v2 is required. Please upgrade Docker."
        exit 1
    fi
}

run_with_retries() {
    local label="$1"
    shift

    local max_attempts="${CONTROL_RETRY_ATTEMPTS:-3}"
    local delay="${CONTROL_RETRY_DELAY:-10}"
    local attempt=1
    local status=0

    while true; do
        set +e
        "$@"
        status=$?
        set -e

        if [ "$status" -eq 0 ]; then
            return 0
        fi

        if [ "$attempt" -ge "$max_attempts" ]; then
            log_error "$label failed after $attempt attempt(s)."
            return "$status"
        fi

        log_warn "$label failed on attempt $attempt/$max_attempts. Retrying in ${delay}s..."
        sleep "$delay"
        attempt=$((attempt + 1))
        if [ "$delay" -lt 60 ]; then
            delay=$((delay * 2))
            if [ "$delay" -gt 60 ]; then
                delay=60
            fi
        fi
    done
}

validate_release_version() {
    local version="${1:-}"

    if [ -z "$version" ] || [ "$version" = "latest" ]; then
        log_error "An explicit immutable application version is required (for example: v1.2.3)."
        return 1
    fi

    if ! is_valid_release_version "$version"; then
        log_error "Invalid application version tag: $version"
        return 1
    fi
}

persist_release_version() {
    local version="${1:-}"
    validate_release_version "$version" || return 1

    mkdir -p "$CONFIG_DIR"
    local temporary_file
    temporary_file="$(mktemp "$CONFIG_DIR/.release-version.XXXXXX")"
    if ! printf '%s\n' "$version" > "$temporary_file" \
        || ! chmod 600 "$temporary_file" \
        || ! mv -f "$temporary_file" "$RELEASE_VERSION_FILE"; then
        rm -f "$temporary_file"
        log_error "Failed to persist application release version"
        return 1
    fi

    CONTROL_PINNED_RELEASE_VERSION="$version"
}

check_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration not found at $CONFIG_FILE"
        log_error "Run './bin/configure init' first to create configuration."
        exit 1
    fi

    if ! bash "$SCRIPT_DIR/upgrade-config" "$CONFIG_FILE"; then
        log_error "Configuration validation or upgrade failed."
        exit 1
    fi
}

# Generate .docker-env from settings.json
generate_env_file() {
    log_step "Generating environment file..."

    local app_keys=$(jq -r '.app.keys // empty' "$CONFIG_FILE")
    local app_port=$(jq -r '.app.port // 7001' "$CONFIG_FILE")
    local db_host=$(jq -r '.database.host // "postgres"' "$CONFIG_FILE")
    local db_port=$(jq -r '.database.port // 5432' "$CONFIG_FILE")
    local db_password=$(jq -r '.database.password // empty' "$CONFIG_FILE")
    local db_username=$(jq -r '.database.username // "postgres"' "$CONFIG_FILE")
    local db_name=$(jq -r '.database.database // "streamerhelper"' "$CONFIG_FILE")
    local redis_host=$(jq -r '.redis.host // "redis"' "$CONFIG_FILE")
    local redis_port=$(jq -r '.redis.port // 6379' "$CONFIG_FILE")
    local s3_endpoint=$(jq -r ".s3.endpoint // \"$DEFAULT_INTERNAL_MINIO_ENDPOINT\"" "$CONFIG_FILE")
    local s3_public_endpoint=$(jq -r ".s3.publicEndpoint // \"$DEFAULT_PUBLIC_MINIO_ENDPOINT\"" "$CONFIG_FILE")
    local s3_access_key=$(jq -r '.s3.accessKey // "minioadmin"' "$CONFIG_FILE")
    local s3_secret_key=$(jq -r '.s3.secretKey // empty' "$CONFIG_FILE")
    local s3_bucket=$(jq -r '.s3.bucket // "streamerhelper-archive"' "$CONFIG_FILE")
    local s3_region=$(jq -r '.s3.region // "us-east-1"' "$CONFIG_FILE")
    local http_port=$(jq -r ".http.port // $DEFAULT_HTTP_PORT" "$CONFIG_FILE")
    local https_port=$(jq -r ".http.httpsPort // $DEFAULT_HTTPS_PORT" "$CONFIG_FILE")
    local minio_console_port=$(jq -r ".minio.consolePort // $DEFAULT_MINIO_CONSOLE_PORT" "$CONFIG_FILE")
    local minio_api_port=$(jq -r ".minio.apiPort // $DEFAULT_MINIO_API_PORT" "$CONFIG_FILE")
    local redis_password=$(jq -r '.redis.password // ""' "$CONFIG_FILE")
    local timezone=$(jq -r '.app.timezone // "Asia/Shanghai"' "$CONFIG_FILE")
    local backend_version frontend_version browser_version douyin_resolver_version
    backend_version="$(resolve_backend_version)" || return 1
    frontend_version="$(resolve_frontend_version)" || return 1
    browser_version="$(resolve_browser_version)" || return 1
    douyin_resolver_version="$(resolve_douyin_resolver_version)" || return 1

    if [ -z "$app_keys" ] || [ -z "$db_password" ] || [ -z "$s3_secret_key" ]; then
        log_error "Invalid config: missing app.keys, database.password, or s3.secretKey"
        exit 1
    fi

    local normalized_db
    normalized_db=$(normalize_service_connection "$db_host" "$db_port" "postgres" "5432")
    local normalized_db_host="${normalized_db% *}"
    local normalized_db_port="${normalized_db#* }"

    local normalized_redis
    normalized_redis=$(normalize_service_connection "$redis_host" "$redis_port" "redis" "6379")
    local normalized_redis_host="${normalized_redis% *}"
    local normalized_redis_port="${normalized_redis#* }"

    local normalized_s3_endpoint
    normalized_s3_endpoint=$(normalize_internal_s3_endpoint "$s3_endpoint" "$minio_api_port")
    local normalized_s3_public_endpoint
    normalized_s3_public_endpoint=$(normalize_public_s3_endpoint "$s3_public_endpoint" "$minio_api_port")

    if [ "$app_port" != "7001" ]; then
        log_warn "Docker deployment keeps backend internal port fixed at 7001. Use http.port to change the public access port."
    fi
    if [ "$db_host:$db_port" != "$normalized_db_host:$normalized_db_port" ]; then
        log_warn "Using Docker-internal PostgreSQL connection ${normalized_db_host}:${normalized_db_port} instead of ${db_host}:${db_port}"
    fi
    if [ "$redis_host:$redis_port" != "$normalized_redis_host:$normalized_redis_port" ]; then
        log_warn "Using Docker-internal Redis connection ${normalized_redis_host}:${normalized_redis_port} instead of ${redis_host}:${redis_port}"
    fi
    if [ "$s3_endpoint" != "$normalized_s3_endpoint" ]; then
        log_warn "Using Docker-internal S3 endpoint ${normalized_s3_endpoint} instead of ${s3_endpoint}"
    fi
    if [ "$s3_public_endpoint" != "$normalized_s3_public_endpoint" ]; then
        log_warn "Using browser-facing S3 endpoint ${normalized_s3_public_endpoint} instead of ${s3_public_endpoint}"
    fi

    mkdir -p "$CONFIG_DIR" "$CONFIG_DIR/Logs/backend" "$CONFIG_DIR/Logs/nginx"

    cat > "$ENV_FILE" << EOF
# Auto-generated from settings.json - DO NOT EDIT DIRECTLY
TZ=${timezone}
APP_KEYS=${app_keys}
APP_PORT=7001
TYPEORM_HOST=${normalized_db_host}
TYPEORM_PORT=${normalized_db_port}
TYPEORM_USERNAME=${db_username}
TYPEORM_PASSWORD=${db_password}
TYPEORM_DATABASE=${db_name}
REDIS_HOST=${normalized_redis_host}
REDIS_PORT=${normalized_redis_port}
S3_ENDPOINT=${normalized_s3_endpoint}
S3_PUBLIC_ENDPOINT=${normalized_s3_public_endpoint}
S3_ACCESS_KEY=${s3_access_key}
S3_SECRET_KEY=${s3_secret_key}
S3_BUCKET=${s3_bucket}
S3_REGION=${s3_region}
REDIS_PASSWORD=${redis_password}
HTTP_PORT=${http_port}
HTTPS_PORT=${https_port}
MINIO_CONSOLE_PORT=${minio_console_port}
MINIO_API_PORT=${minio_api_port}
CONFIG_DIR=${CONFIG_DIR}
EOF

    printf 'BACKEND_VERSION=%s\nFRONTEND_VERSION=%s\nBROWSER_VERSION=%s\nDOUYIN_RESOLVER_VERSION=%s\n' \
        "$backend_version" \
        "$frontend_version" \
        "$browser_version" \
        "$douyin_resolver_version" >> "$ENV_FILE"

    chmod 600 "$ENV_FILE"
}

# Generate pgAdmin configuration files
generate_pgadmin_config() {
    local db_host=$(jq -r '.database.host // "postgres"' "$CONFIG_FILE")
    local db_port=$(jq -r '.database.port // 5432' "$CONFIG_FILE")
    local db_username=$(jq -r '.database.username // "postgres"' "$CONFIG_FILE")
    local db_name=$(jq -r '.database.database // "streamerhelper"' "$CONFIG_FILE")
    local normalized_db
    normalized_db=$(normalize_service_connection "$db_host" "$db_port" "postgres" "5432")
    db_host="${normalized_db% *}"
    db_port="${normalized_db#* }"

    local pgadmin_dir="$CONFIG_DIR/pgadmin"
    mkdir -p "$pgadmin_dir"

    # Generate servers.json
    cat > "$pgadmin_dir/servers.json" << EOF
{
  "Servers": {
    "1": {
      "Name": "StreamerHelper PostgreSQL",
      "Group": "Servers",
      "Host": "${db_host}",
      "Port": ${db_port},
      "MaintenanceDB": "${db_name}",
      "Username": "${db_username}",
      "SSLMode": "prefer"
    }
  }
}
EOF
}

# Sync PostgreSQL password
sync_postgres_password() {
    local config_password=$(jq -r '.database.password' "$CONFIG_FILE")
    local container_name="streamer-postgres"

    # Wait for postgres to be ready
    local max_wait=30
    local waited=0
    while [ $waited -lt $max_wait ]; do
        if docker exec "$container_name" pg_isready -U postgres > /dev/null 2>&1; then
            break
        fi
        sleep 2
        waited=$((waited + 2))
    done

    if [ $waited -ge $max_wait ]; then
        log_warn "PostgreSQL not ready, skipping password sync"
        return
    fi

    # Sync password
    log_step "Syncing PostgreSQL password..."
    if docker exec "$container_name" psql -U postgres -c "ALTER USER postgres WITH PASSWORD '${config_password}';" > /dev/null 2>&1; then
        log_info "PostgreSQL password synced."
    else
        log_warn "Failed to sync PostgreSQL password"
    fi
}

# Wait for service to be healthy
wait_for_healthy() {
    local container=$1
    local max_wait=${2:-120}
    local waited=0

    while [ $waited -lt $max_wait ]; do
        local status=$(docker inspect "$container" --format '{{.State.Health.Status}}' 2>/dev/null || echo "not_found")
        if [ "$status" = "healthy" ]; then
            return 0
        fi
        sleep 3
        waited=$((waited + 3))
        echo "  Waiting for $container... (${waited}s/${max_wait}s) - status: $status"
    done

    return 1
}

check_optional_application_services() {
    local degraded=0

    log_step "Checking optional Douyin services..."
    if ! wait_for_healthy "streamer-browser" 30; then
        log_warn "Browser is not healthy; Douyin login and browser fallback are unavailable."
        docker logs streamer-browser --tail 30 || true
        degraded=1
    fi

    if ! wait_for_healthy "streamer-douyin-resolver" 30; then
        log_warn "Douyin resolver is not healthy; Douyin polling will use backend fallbacks."
        docker logs streamer-douyin-resolver --tail 30 || true
        degraded=1
    fi

    if [ "$degraded" -eq 1 ]; then
        log_warn "Application is running in degraded mode; other platforms remain available."
    else
        log_info "Optional Douyin services are healthy."
    fi

    return 0
}

restore_application_release() {
    local version="${1:-}"
    validate_release_version "$version" || return 1
    CONTROL_BACKEND_VERSION="$version"
    CONTROL_FRONTEND_VERSION="$version"
    CONTROL_BROWSER_VERSION="$version"
    CONTROL_DOUYIN_RESOLVER_VERSION="$version"

    log_warn "Restoring previous application release: $version"
    if ! compose_app up -d --force-recreate; then
        log_error "Failed to recreate the previous application release"
        return 1
    fi
    if ! wait_for_healthy "streamer-backend" 180; then
        log_error "Previous backend release failed to become healthy"
        docker logs streamer-backend --tail 30 || true
        return 1
    fi
    if ! wait_for_healthy "streamer-frontend" 180; then
        log_error "Previous frontend release failed to become healthy"
        docker logs streamer-frontend --tail 30 || true
        return 1
    fi
    if ! wait_for_healthy "streamer-nginx" 60; then
        log_error "Previous Nginx release failed to become healthy"
        docker logs streamer-nginx --tail 30 || true
        return 1
    fi

    check_optional_application_services
    log_info "Previous application release restored."
}

attempt_application_recovery() {
    local previous_version="${1:-}"

    if [ -z "$previous_version" ]; then
        log_warn "No previous pinned release is available for automatic recovery."
        return 0
    fi

    if ! restore_application_release "$previous_version"; then
        log_error "Automatic application recovery failed; manual intervention is required."
        return 1
    fi
}

cleanup_candidate_application() {
    log_warn "Removing candidate application containers to preserve the stopped state."
    if ! compose_app down; then
        log_error "Failed to remove candidate application containers; manual intervention is required."
        return 1
    fi
    log_info "Application services remain stopped."
}

preserve_application_state_after_failure() {
    local previous_version="${1:-}"
    local application_was_running="${2:-0}"
    local previous_release_still_running="${3:-0}"
    local candidate_may_exist="${4:-0}"

    if [ "$application_was_running" -eq 1 ]; then
        if [ "$previous_release_still_running" -eq 1 ]; then
            log_info "Previous application release remains running."
            return 0
        fi

        if [ -n "$previous_version" ]; then
            attempt_application_recovery "$previous_version"
            return
        fi

        log_error "The application was running before the update, but no previous release pin is available for recovery."
        if [ "$candidate_may_exist" -eq 1 ]; then
            cleanup_candidate_application || true
        fi
        return 1
    fi

    if [ "$candidate_may_exist" -eq 1 ]; then
        cleanup_candidate_application
        return
    fi

    log_info "Application services remain stopped."
}

application_services_running() {
    docker ps --format '{{.Names}}' \
        | grep -Eq '^streamer-(backend|frontend|browser|douyin-resolver|nginx)$'
}

# Ensure MinIO bucket exists
ensure_minio_bucket() {
    local bucket=$(jq -r '.s3.bucket // "streamerhelper-archive"' "$CONFIG_FILE")
    local access_key=$(jq -r '.s3.accessKey // "minioadmin"' "$CONFIG_FILE")
    local secret_key=$(jq -r '.s3.secretKey' "$CONFIG_FILE")

    log_step "Ensuring MinIO bucket exists: $bucket"

    # Configure mc alias inside container
    local minio_api_port=$(jq -r ".minio.apiPort // $DEFAULT_MINIO_API_PORT" "$CONFIG_FILE")
    docker exec streamer-minio mc alias set local "http://localhost:${minio_api_port}" "$access_key" "$secret_key" > /dev/null 2>&1

    # Create bucket if not exists
    if docker exec streamer-minio mc ls local/"$bucket" > /dev/null 2>&1; then
        log_info "Bucket '$bucket' already exists"
    else
        if docker exec streamer-minio mc mb local/"$bucket" > /dev/null 2>&1; then
            log_info "Bucket '$bucket' created"
        else
            log_warn "Failed to create bucket '$bucket'"
        fi
    fi
}

#=============================================================#
#  Infrastructure Commands                                    #
#=============================================================#

do_infra_up() {
    echo ""
    echo -e "${CYAN}Starting Infrastructure Services...${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file

    log_step "Starting PostgreSQL, Redis, MinIO..."
    docker compose -f "$COMPOSE_INFRA" --env-file "$ENV_FILE" up -d

    log_step "Waiting for services to be healthy..."
    wait_for_healthy "streamer-postgres" 60 || { log_error "PostgreSQL failed to start"; exit 1; }
    wait_for_healthy "streamer-redis" 30 || { log_error "Redis failed to start"; exit 1; }
    wait_for_healthy "streamer-minio" 60 || { log_error "MinIO failed to start"; exit 1; }

    sync_postgres_password
    ensure_minio_bucket

    log_info "Infrastructure services are ready!"
    echo ""
}

do_infra_down() {
    check_dependencies
    check_config
    generate_env_file
    log_step "Stopping infrastructure services..."
    docker compose -f "$COMPOSE_INFRA" down
    log_info "Infrastructure services stopped."
}

#=============================================================#
#  Migration Commands                                         #
#=============================================================#

do_migrate() {
    echo ""
    echo -e "${CYAN}Running Database Migrations...${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file

    # Check if infra is running
    if ! docker ps --format '{{.Names}}' | grep -q "streamer-postgres"; then
        log_error "PostgreSQL is not running. Run './bin/control infra up' first."
        exit 1
    fi

    local image_to_use

    # Check if local image exists
    if [ "${FORCE_REMOTE_BACKEND_IMAGE:-0}" != "1" ] \
        && docker images --format '{{.Repository}}:{{.Tag}}' | grep -q "infra-backend:local"; then
        image_to_use="infra-backend:local"
        log_info "Using local backend image"
    else
        if ! image_to_use="$(resolve_backend_image)"; then
            require_pinned_release_version
            return 1
        fi
        log_info "Using remote backend image: $image_to_use"
    fi

    log_step "Running migrations..."
    if ! docker run --rm \
        --network streamer-network \
        --env-file "$ENV_FILE" \
        --entrypoint "" \
        "$image_to_use" \
        npm run migration:run:prod; then
        log_error "Database migrations failed."
        return 1
    fi

    log_info "Migrations completed!"
    echo ""
}

#=============================================================#
#  Application Commands                                       #
#=============================================================#

do_app_up() {
    echo ""
    echo -e "${CYAN}Starting Application Services...${NC}"
    echo ""

    require_pinned_release_version || return 1
    check_dependencies
    check_config
    generate_env_file

    # Check if infra is running
    if ! docker ps --format '{{.Names}}' | grep -q "streamer-postgres"; then
        log_error "Infrastructure services are not running."
        log_error "Run './bin/control infra up' first."
        exit 1
    fi

    log_step "Starting browser, Douyin resolver, backend, frontend, and nginx..."
    compose_app up -d

    log_step "Waiting for backend to be healthy..."
    if ! wait_for_healthy "streamer-backend" 180; then
        log_error "Backend failed to start"
        docker logs streamer-backend --tail 30
        exit 1
    fi

    log_step "Waiting for frontend to be healthy..."
    if ! wait_for_healthy "streamer-frontend" 180; then
        log_error "Frontend failed to start"
        docker logs streamer-frontend --tail 30
        exit 1
    fi

    check_optional_application_services

    log_info "Application services are ready!"

    local http_port=$(jq -r ".http.port // $DEFAULT_HTTP_PORT" "$CONFIG_FILE")
    local minio_port=$(jq -r ".minio.consolePort // $DEFAULT_MINIO_CONSOLE_PORT" "$CONFIG_FILE")

    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║${NC}  Application:   http://localhost:${http_port}"
    echo -e "${GREEN}║${NC}  MinIO Console: http://localhost:${minio_port}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

#=============================================================#
#  Single-service release                                     #
#=============================================================#

# Release one application service without touching the others.
# Usage: app release <service> <version> [--no-pull]
do_app_release() {
    local service="${1:-}"
    local version="${2:-}"
    local pull_missing="${3:-1}"

    case "$service" in
        backend|frontend|browser|douyin-resolver|all) ;;
        *)
            log_error "Usage: ./bin/control app release <backend|frontend|browser|douyin-resolver|all> <version> [--no-pull]"
            return 1
            ;;
    esac
    validate_release_version "$version" || return 1

    check_dependencies
    check_config

    local previous_version=""
    if [ "$service" = "all" ]; then
        previous_version="$(resolve_pinned_release_version || true)"
    else
        previous_version="$(resolve_service_version "$service" || true)"
    fi

    if [ "$service" != "all" ]; then
        local image="$DOCKER_REGISTRY/$DOCKER_ORG/$IMAGE_PREFIX-$service:$version"
        if ! docker image inspect "$image" >/dev/null 2>&1; then
            if [ "$pull_missing" = "0" ]; then
                log_error "Image not found locally: $image"
                return 1
            fi
            log_step "Pulling $image ..."
            if ! docker pull "$image"; then
                log_error "Failed to pull $image"
                return 1
            fi
        fi
    fi

    if ! write_service_versions "$service" "$version"; then
        log_error "Failed to pin $service to $version"
        return 1
    fi

    generate_env_file

    log_step "Recreating ${service} service(s)..."
    if [ "$service" = "all" ]; then
        if ! compose_app up -d; then
            log_error "Failed to start application services"
            return 1
        fi
        local container
        for container in streamer-backend streamer-frontend; do
            if ! wait_for_healthy "$container" 180; then
                log_error "$container did not become healthy"
                docker logs "$container" --tail 30 || true
                return 1
            fi
        done
    else
        if ! compose_app up -d --no-deps "$service"; then
            log_error "Failed to recreate $service"
            return 1
        fi
        local container
        container="$(service_container_name "$service")" || return 1
        if ! wait_for_healthy "$container" 180; then
            log_error "$container did not become healthy after release"
            if [ -n "$previous_version" ] && [ "$previous_version" != "$version" ]; then
                log_warn "Rolling $service back to $previous_version"
                if write_service_versions "$service" "$previous_version"; then
                    generate_env_file
                    compose_app up -d --no-deps "$service" || true
                fi
            fi
            docker logs "$container" --tail 30 || true
            return 1
        fi
    fi

    log_info "Released $service -> $version"
    if [ -n "$previous_version" ] && [ "$previous_version" != "$version" ]; then
        log_info "Rollback: ./bin/control app release $service $previous_version"
    fi
}

# Restore the version recorded before the last release of one service.
do_app_rollback() {
    local service="${1:-}"
    case "$service" in
        backend|frontend|browser|douyin-resolver) ;;
        *)
            log_error "Usage: ./bin/control app rollback <backend|frontend|browser|douyin-resolver>"
            return 1
            ;;
    esac

    if [ ! -r "$SERVICE_VERSIONS_PREVIOUS_FILE" ]; then
        log_error "No previous service versions recorded at $SERVICE_VERSIONS_PREVIOUS_FILE"
        return 1
    fi

    local version
    version="$(jq -r --arg service "$service" '.[$service] // empty' "$SERVICE_VERSIONS_PREVIOUS_FILE")"
    if ! is_valid_release_version "$version"; then
        log_error "No previous version recorded for $service"
        return 1
    fi

    do_app_release "$service" "$version" 0
}

do_app_down() {
    check_dependencies
    check_config
    generate_env_file
    log_step "Stopping application services..."
    compose_app_down
    log_info "Application services stopped."
}

#=============================================================#
#  Combined Commands                                          #
#=============================================================#

do_up() {
    echo ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}           StreamerHelper Full Deploy                       ${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""

    require_pinned_release_version || return 1
    do_infra_up
    do_migrate
    do_app_up
}

do_down() {
    check_dependencies
    check_config
    generate_env_file
    log_step "Stopping all services..."
    compose_app_down 2>/dev/null || true
    docker compose -f "$COMPOSE_INFRA" down 2>/dev/null || true
    log_info "All services stopped."
}

#=============================================================#
#  Development Commands                                       #
#=============================================================#

do_dev_build() {
    local service="${1:-}"

    echo ""
    echo -e "${CYAN}Building Local Images...${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file

    if [ -n "$service" ]; then
        log_step "Building $service..."
        compose_app_dev build "$service"
    else
        log_step "Building all services..."
        compose_app_dev build
    fi

    log_info "Build complete!"
}

do_dev_up() {
    echo ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}           StreamerHelper Dev Environment                   ${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file
    generate_pgadmin_config

    # Start infra if not running
    if ! docker ps --format '{{.Names}}' | grep -q "streamer-postgres"; then
        do_infra_up
    else
        log_info "Infrastructure already running"
    fi

    # Build images first
    log_step "Building local images..."
    compose_app_dev build

    # Run migrations before starting app
    do_migrate

    # Start app
    log_step "Starting application services..."
    compose_app_dev up -d

    log_step "Waiting for backend to be healthy..."
    if ! wait_for_healthy "streamer-backend" 180; then
        log_error "Backend failed to start"
        docker logs streamer-backend --tail 30
        exit 1
    fi

    log_step "Waiting for frontend to be healthy..."
    if ! wait_for_healthy "streamer-frontend" 180; then
        log_error "Frontend failed to start"
        docker logs streamer-frontend --tail 30
        exit 1
    fi

    check_optional_application_services

    log_info "Dev environment ready!"

    local http_port=$(jq -r ".http.port // $DEFAULT_HTTP_PORT" "$CONFIG_FILE")
    local minio_port=$(jq -r ".minio.consolePort // $DEFAULT_MINIO_CONSOLE_PORT" "$CONFIG_FILE")

    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║${NC}  Application:   http://localhost:${http_port}"
    echo -e "${GREEN}║${NC}  MinIO Console: http://localhost:${minio_port}"
    echo -e "${GREEN}║${NC}  pgAdmin:       http://localhost:7505"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

do_dev_down() {
    check_dependencies
    check_config
    generate_env_file
    log_step "Stopping dev environment..."
    compose_app_dev down 2>/dev/null || true
    log_info "Dev environment stopped."
}

do_dev_restart() {
    do_dev_down
    do_dev_up
}

#=============================================================#
#  Status & Logs                                              #
#=============================================================#

do_status() {
    validate_existing_release_pin || return 1
    check_dependencies
    local pinned_release_version=""
    pinned_release_version="$(resolve_pinned_release_version || true)"
    echo ""
    echo -e "${CYAN}StreamerHelper Services Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ -n "$pinned_release_version" ]; then
        echo "Pinned application release: $pinned_release_version"
    else
        echo "Pinned application release: none"
    fi
    docker ps -a --filter "name=streamer" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    echo ""
}

do_logs() {
    validate_existing_release_pin || return 1
    check_dependencies
    check_config
    generate_env_file
    local service="${1:-}"
    if [ -n "$service" ]; then
        docker logs -f "streamer-$service"
    else
        # Show logs from all streamer containers
        require_pinned_release_version || return 1
        compose_all logs -f
    fi
}

#=============================================================#
#  Update Commands                                            #
#=============================================================#

verify_preloaded_application_images() {
    if [ "$#" -ne 4 ]; then
        log_error "Internal error: exactly four candidate application images are required."
        return 1
    fi

    local image
    local missing=0
    for image in "$@"; do
        if docker image inspect "$image" >/dev/null 2>&1; then
            log_info "Preloaded image found: $image"
        else
            log_error "Preloaded image is missing: $image"
            missing=1
        fi
    done

    if [ "$missing" -ne 0 ]; then
        log_error "Load or pull all four exact candidate image tags before retrying with --preloaded."
        return 1
    fi
}

do_update_app() {
    local version="${1:-}"
    local application_was_running_override="${2:-}"
    local previous_release_still_running_override="${3:-}"
    local use_preloaded_images="${4:-0}"
    local previous_version=""
    local application_was_running=0
    local previous_release_still_running=0

    validate_release_version "$version" || return 1
    case "$application_was_running_override" in
        ""|0|1) ;;
        *)
            log_error "Invalid application running-state override."
            return 1
            ;;
    esac
    case "$previous_release_still_running_override" in
        ""|0|1) ;;
        *)
            log_error "Invalid previous-release state override."
            return 1
            ;;
    esac
    case "$use_preloaded_images" in
        0|1) ;;
        *)
            log_error "Invalid preloaded-image mode."
            return 1
            ;;
    esac
    validate_existing_release_pin || return 1
    previous_version="$(resolve_pinned_release_version || true)"
    CONTROL_BACKEND_VERSION="$version"
    CONTROL_FRONTEND_VERSION="$version"
    CONTROL_BROWSER_VERSION="$version"
    CONTROL_DOUYIN_RESOLVER_VERSION="$version"

    local backend_image
    local frontend_image
    local browser_image
    local douyin_resolver_image
    backend_image="$(resolve_backend_image)"
    frontend_image="$(resolve_frontend_image)"
    browser_image="$(resolve_browser_image)"
    douyin_resolver_image="$(resolve_douyin_resolver_image)"

    echo ""
    echo -e "${CYAN}Updating Application Images...${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file
    if [ -n "$application_was_running_override" ]; then
        application_was_running="$application_was_running_override"
    elif application_services_running; then
        application_was_running=1
    fi
    if [ -n "$previous_release_still_running_override" ]; then
        previous_release_still_running="$previous_release_still_running_override"
    else
        previous_release_still_running="$application_was_running"
    fi

    log_info "Backend image:  $backend_image"
    log_info "Frontend image: $frontend_image"
    log_info "Browser image:  $browser_image"
    log_info "Resolver image: $douyin_resolver_image"

    if [ "$use_preloaded_images" -eq 1 ]; then
        log_step "Verifying preloaded candidate application images..."
        if ! verify_preloaded_application_images \
            "$backend_image" \
            "$frontend_image" \
            "$browser_image" \
            "$douyin_resolver_image"; then
            log_error "Application update aborted before recreating application services."
            preserve_application_state_after_failure \
                "$previous_version" \
                "$application_was_running" \
                "$previous_release_still_running" \
                0 || true
            return 1
        fi
        log_info "Registry pull skipped because all candidate images are preloaded."
    else
        log_step "Pulling application images..."
        if ! run_with_retries "Pulling application images" compose_app pull backend frontend browser douyin-resolver nginx; then
            log_error "Application update aborted before recreating application services."
            preserve_application_state_after_failure \
                "$previous_version" \
                "$application_was_running" \
                "$previous_release_still_running" \
                0 || true
            return 1
        fi
    fi

    if [ "$previous_release_still_running" -eq 1 ]; then
        log_step "Running migrations with the updated backend while current services stay online..."
    else
        log_step "Running migrations with the updated backend before starting application services..."
    fi
    if ! FORCE_REMOTE_BACKEND_IMAGE=1 do_migrate; then
        log_error "Application update aborted; the release pin is unchanged."
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            "$previous_release_still_running" \
            0 || true
        return 1
    fi

    log_step "Starting updated application services..."
    if ! compose_app up -d --force-recreate; then
        log_error "Failed to recreate updated application services."
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            1 || true
        return 1
    fi

    log_step "Waiting for backend to be healthy..."
    if ! wait_for_healthy "streamer-backend" 180; then
        log_error "Backend failed to start after update"
        docker logs streamer-backend --tail 30 || true
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            1 || true
        return 1
    fi

    log_step "Waiting for frontend to be healthy..."
    if ! wait_for_healthy "streamer-frontend" 180; then
        log_error "Frontend failed to start after update"
        docker logs streamer-frontend --tail 30 || true
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            1 || true
        return 1
    fi

    log_step "Waiting for Nginx to be healthy..."
    if ! wait_for_healthy "streamer-nginx" 60; then
        log_error "Nginx failed to start after update"
        docker logs streamer-nginx --tail 30 || true
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            1 || true
        return 1
    fi

    check_optional_application_services

    if ! persist_release_version "$version"; then
        log_error "Updated services are healthy, but the release pin could not be persisted."
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            1 || true
        return 1
    fi
    if ! write_service_versions all "$version"; then
        log_warn "Updated services are healthy, but per-service version pins could not be persisted."
    fi
    log_info "Pinned application release: $version"
    log_info "Application update completed!"
    echo ""
}

do_update_infra() {
    echo ""
    echo -e "${CYAN}Updating Infrastructure Images...${NC}"
    echo ""

    check_dependencies
    check_config
    generate_env_file

    log_step "Pulling infrastructure images..."
    if ! run_with_retries "Pulling infrastructure images" docker compose -f "$COMPOSE_INFRA" --env-file "$ENV_FILE" pull; then
        log_error "Infrastructure update aborted before recreating services."
        exit 1
    fi

    log_step "Recreating infrastructure services..."
    if ! docker compose -f "$COMPOSE_INFRA" --env-file "$ENV_FILE" up -d --force-recreate; then
        log_error "Failed to recreate infrastructure services."
        return 1
    fi

    log_step "Waiting for services to be healthy..."
    wait_for_healthy "streamer-postgres" 60 || { log_error "PostgreSQL failed to become healthy after update"; exit 1; }
    wait_for_healthy "streamer-redis" 30 || { log_error "Redis failed to become healthy after update"; exit 1; }
    wait_for_healthy "streamer-minio" 60 || { log_error "MinIO failed to become healthy after update"; exit 1; }

    sync_postgres_password
    ensure_minio_bucket

    log_info "Infrastructure update completed!"
    echo ""
}

do_update_all() {
    local version="${1:-}"
    validate_release_version "$version" || return 1
    validate_existing_release_pin || return 1
    local previous_version=""
    local application_was_running=0
    previous_version="$(resolve_pinned_release_version || true)"

    check_dependencies
    check_config
    generate_env_file

    if application_services_running; then
        application_was_running=1
        log_step "Stopping application services before infrastructure update..."
        if ! compose_app_down; then
            log_error "Failed to stop the current application cleanly; attempting recovery."
            preserve_application_state_after_failure \
                "$previous_version" \
                "$application_was_running" \
                0 \
                0 || true
            return 1
        fi
    fi

    if ! (do_update_infra); then
        log_error "Infrastructure update failed; preserving the previous application state."
        preserve_application_state_after_failure \
            "$previous_version" \
            "$application_was_running" \
            0 \
            0 || true
        return 1
    fi

    if ! (do_update_app "$version" "$application_was_running" 0 0); then
        log_error "Application update failed; its recovery path has completed."
        return 1
    fi
}

#=============================================================#
#  Help & Main                                                #
#=============================================================#

print_usage() {
    echo ""
    echo -e "${CYAN}Usage:${NC} ./bin/control <command> [subcommand] [options]"
    echo ""
    echo -e "${CYAN}Infrastructure:${NC}"
    echo "  infra up       Start infrastructure (postgres, redis, minio)"
    echo "  infra down     Stop infrastructure"
    echo ""
    echo -e "${CYAN}Database:${NC}"
    echo "  migrate        Run database migrations"
    echo ""
    echo -e "${CYAN}Application:${NC}"
    echo "  app up         Start the pinned application release"
    echo "  app down       Stop application services"
    echo "  app release <service> <version>  Release one service (no-op for others)"
    echo "  app rollback <service>           Restore the previous version of one service"
    echo ""
    echo -e "${CYAN}Combined:${NC}"
    echo "  up             Start everything using the pinned application release"
    echo "  down           Stop all services"
    echo "  update app <v> [--preloaded] | update all <v> | update infra"
    echo "  status         Show service status"
    echo "  logs [service] Show logs (e.g., logs backend)"
    echo ""
    echo -e "${CYAN}Development:${NC}"
    echo "  dev up         Build from source and start (includes pgAdmin)"
    echo "  dev down       Stop dev environment"
    echo "  dev restart    Restart dev environment"
    echo "  dev build [s]  Build images (optionally specify service)"
    echo ""
    echo -e "${CYAN}Examples:${NC}"
    echo "  ./bin/control update all v1.2.3  # First install of an immutable release"
    echo "  ./bin/control up           # Restart the currently pinned release"
    echo "  ./bin/control update app v1.2.3  # Update one immutable application release"
    echo "  ./bin/control update app v1.2.3 --preloaded  # Use four preloaded candidate images"
    echo "  ./bin/control app release backend v1.2.3  # Backend-only release"
    echo "  ./bin/control app rollback backend        # Undo the last backend release"
    echo "  ./bin/control dev up       # Development mode"
    echo ""
}

# Main
main() {
    local use_preloaded_images=0
case "${1:-}" in
    infra)
        case "${2:-}" in
            up) do_infra_up ;;
            down) do_infra_down ;;
            *) log_error "Usage: ./bin/control infra [up|down]"; exit 1 ;;
        esac
        ;;
    migrate)
        do_migrate
        ;;
    app)
        case "${2:-}" in
            up) do_app_up ;;
            down) do_app_down ;;
            release)
                local pull_missing=1
                if [ "${5:-}" = "--no-pull" ]; then
                    pull_missing=0
                elif [ -n "${5:-}" ]; then
                    log_error "Usage: ./bin/control app release <service> <version> [--no-pull]"
                    exit 1
                fi
                do_app_release "${3:-}" "${4:-}" "$pull_missing"
                ;;
            rollback) do_app_rollback "${3:-}" ;;
            *) log_error "Usage: ./bin/control app [up|down|release|rollback]"; exit 1 ;;
        esac
        ;;
    up)
        do_up
        ;;
    down)
        do_down
        ;;
    update)
        case "${2:-all}" in
            app)
                case "${4:-}" in
                    "")
                        use_preloaded_images=0
                        ;;
                    --preloaded)
                        use_preloaded_images=1
                        ;;
                    *)
                        log_error "Usage: ./bin/control update app <version> [--preloaded]"
                        exit 1
                        ;;
                esac
                if [ -n "${5:-}" ]; then
                    log_error "Usage: ./bin/control update app <version> [--preloaded]"
                    exit 1
                fi
                do_update_app "$3" "" "" "$use_preloaded_images"
                ;;
            infra)
                if [ -n "${3:-}" ]; then
                    log_error "Usage: ./bin/control update infra"
                    exit 1
                fi
                do_update_infra
                ;;
            all)
                if [ -n "${4:-}" ]; then
                    log_error "Usage: ./bin/control update all <version>"
                    exit 1
                fi
                do_update_all "$3"
                ;;
            *)
                log_error "Usage: ./bin/control update app <version> [--preloaded] | update infra | update all <version>"
                exit 1
                ;;
        esac
        ;;
    status)
        do_status
        ;;
    logs)
        do_logs "$2"
        ;;
    dev)
        case "${2:-}" in
            up) do_dev_up ;;
            down) do_dev_down ;;
            restart) do_dev_restart ;;
            build) do_dev_build "$3" ;;
            *) log_error "Usage: ./bin/control dev [up|down|restart|build]"; exit 1 ;;
        esac
        ;;
    help|--help|-h|"")
        print_usage
        ;;
    *)
        log_error "Unknown command: $1"
        print_usage
        exit 1
        ;;
esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
